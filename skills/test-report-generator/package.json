{
  "name": "test-report-generator",
  "version": "1.0.0",
  "description": "Skill：测试执行后自动解析结果并生成结构化测试报告（Jest/Vitest JSON + JUnit XML，默认 Markdown）",
  "type": "module",
  "bin": {
    "test-report": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/index.js parse --result-file samples/junit-sample.xml --output-path reports/smoke-report.md"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": ["test", "report", "junit", "jest", "vitest", "skill", "markdown"],
  "license": "MIT"
}
